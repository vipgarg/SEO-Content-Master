# Postgres — content engine's own database (not Supabase, not BDIP's DB)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/seo_content_master

# Redis — BullMQ queue backend
REDIS_URL=redis://localhost:6379

# Gemini — dedicated Google Cloud project, billing OFF (see docs/generation-plan-v3.1.md §2)
# Never point this at a project that also carries paid Gemini usage.
GEMINI_API_KEY=
GEMINI_PROJECT_ID=

# Token bucket / daily budget (headroom below the live free-tier caps —
# re-verify the live caps before changing these; see plan §2)
GEMINI_RPM_LIMIT=8
GEMINI_RPD_LIMIT=1200

# Claude — generation + self-critique (must stay a different model
# family from the verifier; see plan §1)
ANTHROPIC_API_KEY=

LOG_LEVEL=info
